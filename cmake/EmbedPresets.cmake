# Turns the Resolume preset files in PRESET_DIR into a C++ source (OUTPUT)
# with each file as a byte array, so the plugin can install them itself.
# Run as a script: cmake -DPRESET_DIR=... -DOUTPUT=... -P EmbedPresets.cmake

file(GLOB presets "${PRESET_DIR}/*.xml")
list(SORT presets)

set(arrays "")
set(entries "")
set(index 0)
foreach(preset IN LISTS presets)
    get_filename_component(name "${preset}" NAME)
    file(READ "${preset}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND arrays "const unsigned char kPreset${index}[] = { ${bytes} };\n")
    string(APPEND entries "\t{ \"${name}\", kPreset${index}, sizeof( kPreset${index} ) },\n")
    math(EXPR index "${index} + 1")
endforeach()

file(WRITE "${OUTPUT}.tmp"
"// Generated by cmake/EmbedPresets.cmake from presets/; do not edit.
#include \"Presets.h\"

namespace swarm
{
namespace
{
${arrays}}// namespace

const EmbeddedPreset kEmbeddedPresets[] = {
${entries}};
const size_t kEmbeddedPresetCount = ${index};
}// namespace swarm
")
# Only touch the output when it changed, so builds stay incremental.
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
